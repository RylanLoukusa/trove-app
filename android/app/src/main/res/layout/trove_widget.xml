<?xml version="1.0" encoding="utf-8"?>
<!-- Trove's mark, then Today (or the first list), then This week (or the
     second list) when the widget is tall enough. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/trove_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/trove_widget_background"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:importantForAccessibility="no"
      android:src="@drawable/trove_widget_mark" />

    <TextView
      android:id="@+id/trove_widget_brand"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="5dp"
      android:text="Trove"
      android:textColor="@color/trove_widget_accent"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/trove_widget_section_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/trove_widget_title_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/trove_widget_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/trove_widget_count_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/trove_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <TextView
      android:id="@+id/trove_widget_note_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="@color/trove_widget_muted"
      android:textSize="13sp"
      android:visibility="gone" />
    <TextView android:id="@+id/trove_widget_line_1_1" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_1_2" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_1_3" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_1_4" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_1_5" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_1_6" style="@style/TroveWidgetLine" />

    <TextView
      android:id="@+id/trove_widget_more_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="@color/trove_widget_muted"
      android:textSize="11sp"
      android:visibility="gone" />
  </LinearLayout>

  <View
    android:id="@+id/trove_widget_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp"
    android:background="@color/trove_widget_rule"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/trove_widget_section_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/trove_widget_title_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/trove_widget_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/trove_widget_count_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/trove_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <TextView
      android:id="@+id/trove_widget_note_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="@color/trove_widget_muted"
      android:textSize="13sp"
      android:visibility="gone" />
    <TextView android:id="@+id/trove_widget_line_2_1" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_2_2" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_2_3" style="@style/TroveWidgetLine" />
    <TextView android:id="@+id/trove_widget_line_2_4" style="@style/TroveWidgetLine" />

    <TextView
      android:id="@+id/trove_widget_more_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="@color/trove_widget_muted"
      android:textSize="11sp"
      android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
