<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/trove_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/trove_widget_background"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/trove_widget_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/trove_widget_accent"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/trove_widget_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:textColor="@color/trove_widget_muted"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/trove_widget_note"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:textColor="@color/trove_widget_muted"
    android:textSize="13sp"
    android:visibility="gone" />

  <TextView android:id="@+id/trove_widget_line_1" style="@style/TroveWidgetLine" />
  <TextView android:id="@+id/trove_widget_line_2" style="@style/TroveWidgetLine" />
  <TextView android:id="@+id/trove_widget_line_3" style="@style/TroveWidgetLine" />
  <TextView android:id="@+id/trove_widget_line_4" style="@style/TroveWidgetLine" />
  <TextView android:id="@+id/trove_widget_line_5" style="@style/TroveWidgetLine" />
  <TextView android:id="@+id/trove_widget_line_6" style="@style/TroveWidgetLine" />

  <TextView
    android:id="@+id/trove_widget_more"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="@color/trove_widget_muted"
    android:textSize="11sp"
    android:visibility="gone" />
</LinearLayout>
